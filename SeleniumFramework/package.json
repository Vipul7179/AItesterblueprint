{
  "name": "seleniumframework",
  "version": "1.0.0",
  "description": "Selenium TypeScript semantic login automation",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run.cjs",
    "test:headed": "node scripts/run.cjs --headed",
    "test:valid": "node scripts/run.cjs --grep \"^Valid login\"",
    "test:invalid": "node scripts/run.cjs --grep \"^Invalid login\"",
    "test:invalid:headed": "node scripts/run.cjs --headed --grep \"^Invalid login\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/selenium-webdriver": "^4.35.7",
    "dotenv": "^18.0.9",
    "mocha": "^12.0.3",
    "selenium-webdriver": "^4.51.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
